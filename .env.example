NODE_ENV=development
APP_PORT=3000
CORS_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"

MONGO_URI=""

JWT_SECRET=""
JWT_EXPIRES_IN="7d"
ADMIN_SETUP_TOKEN=""
BOOTSTRAP_ENABLED=true
ADMIN_RESET_ENABLED=true

NFSE_POLLING_ENABLED=true
NFSE_POLLING_INTERVAL_MS=300000
NFSE_POLLING_JITTER_MS=15000
NFSE_POLLING_LIMIT=50
NFSE_POLLING_OLDER_THAN_MS=30000
NFSE_SYNC_ARTIFACTS_MIN_INTERVAL_MS=60000

NFSE_STORE_ARTIFACTS=true
NFSE_CMUN_IBGE=1302603

# Webhook (opcional, recomendado em produção)
# Se definido, o backend valida o token enviado no header abaixo.
WEBHOOK_SHARED_SECRET=
WEBHOOK_SHARED_SECRET_HEADER=x-webhook-token

# Certificado digital da empresa
# Chave de criptografia para senha do certificado (se vazio, usa JWT_SECRET)
EMPRESA_CERT_ENCRYPTION_KEY=
# Tamanho máximo do arquivo de certificado
EMPRESA_CERT_MAX_SIZE_BYTES=5000000

# PlugNotas - escolha UM ambiente
# Sandbox (homologação)
PLUGNOTAS_ENV=sandbox
PLUGNOTAS_BASE_URL=https://api.sandbox.plugnotas.com.br
PLUGNOTAS_API_KEY=

# Produção (preencha quando receber as credenciais)
# PLUGNOTAS_ENV=production
# PLUGNOTAS_BASE_URL=https://api.plugnotas.com.br
# PLUGNOTAS_API_KEY=

# Endpoints auxiliares (ajuste se o provider indicar outro path)
PLUGNOTAS_CNPJ_PATH=/cnpj/{cnpj}
PLUGNOTAS_NFSE_XML_PATH=/nfse/xml/{id}
PLUGNOTAS_NFSE_PDF_PATH=/nfse/pdf/{id}

# Pré-requisitos NFSe Nacional (modo seguro)
# off: desativado (default, não altera comportamento atual)
# warn: tenta validar/habilitar e só loga falhas
# enforce: bloqueia emissão quando pré-requisito falhar
PLUGNOTAS_PREREQ_MODE=off
PLUGNOTAS_PREREQ_CHECK_CITY=true
PLUGNOTAS_PREREQ_ENABLE_COMPANY=false
PLUGNOTAS_PREREQ_CITY_PATH=/Auxiliares/getCidadeById?id={ibge}
PLUGNOTAS_PREREQ_COMPANY_PATH=/Empresa/updateCompany
PLUGNOTAS_PREREQ_CACHE_TTL_MS=3600000

# Emissão rápida (POST /nfse/quick)
# CNPJ do prestador usado no quick flow (se vazio, usa a empresa mais recente com certificado)
QUICK_NFSE_PRESTADOR_CNPJ=
QUICK_NFSE_CODIGO_NACIONAL=171901
QUICK_NFSE_CODIGO_TRIBUTACAO=100
QUICK_NFSE_DESCRICAO_PADRAO=Prestacao de servicos
QUICK_NFSE_ISS_ALIQUOTA=

# Consulta de CNPJ para cadastro (preview)
CNPJA_BASE_URL=https://api.cnpja.com
CNPJA_API_KEY=
CNPJA_TIMEOUT_MS=12000
CNPJA_INCLUDE_SIMPLES=true
CNPJA_INCLUDE_SUFRAMA=true
CNPJA_REGISTRATIONS_MODE=ORIGIN
CNPJA_CACHE_STRATEGY=CACHE_IF_ERROR
CNPJA_CACHE_MAX_AGE_DAYS=45
CNPJA_CACHE_MAX_STALE_DAYS=365

BRASILAPI_BASE_URL=https://brasilapi.com.br/api/cnpj/v1
BRASILAPI_TIMEOUT_MS=12000
