## Aplicacao
# Em producao, mantenha NODE_ENV=production.
# Para bootstrap inicial em banco vazio, o endpoint /auth/bootstrap so aparece fora de production.
NODE_ENV=production
APP_PORT=3000
CORS_ORIGINS=https://zera.net.br,https://www.zera.net.br,http://localhost:8080,http://127.0.0.1:8080
FRONTEND_APP_URL=https://zera.net.br
FRONTEND_URL=https://zera.net.br
SWAGGER_SERVER_URL=

## Docker / Oracle VPS (opcional)
# Use DNS explicito se o container nao conseguir resolver o Mongo Atlas via SRV.
DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8

# PORT e RENDER_EXTERNAL_URL costumam ser injetadas pela plataforma e nao devem ser
# fixadas aqui sem necessidade.
# PORT=3000
# RENDER_EXTERNAL_URL=https://zera-backend.onrender.com

## Banco
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority&appName=zera

## Auth / onboarding
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
ADMIN_SETUP_TOKEN=change-me-before-bootstrap
BOOTSTRAP_ENABLED=true
ADMIN_RESET_ENABLED=true
USER_INVITE_TTL_HOURS=72

## Webhook
WEBHOOK_SHARED_SECRET=change-me-in-production
WEBHOOK_SHARED_SECRET_HEADER=x-webhook-token

## Certificado digital da empresa
# Se vazio, o backend usa JWT_SECRET para criptografar a senha do certificado.
EMPRESA_CERT_ENCRYPTION_KEY=
EMPRESA_CERT_MAX_SIZE_BYTES=5000000

## Polling / artifacts / catalogo
NFSE_POLLING_ENABLED=true
NFSE_POLLING_INTERVAL_MS=60000
NFSE_POLLING_JITTER_MS=3000
NFSE_POLLING_LIMIT=50
NFSE_POLLING_OLDER_THAN_MS=30000
NFSE_POLLING_BACKOFF_BASE_MS=60000
NFSE_POLLING_BACKOFF_MAX_MS=900000
NFSE_POLLING_BACKOFF_JITTER_MS=5000
NFSE_POLLING_MAX_ATTEMPTS=12
NFSE_SYNC_ARTIFACTS_MIN_INTERVAL_MS=60000
NFSE_STORE_ARTIFACTS=true
NFSE_SERVICOS_CATALOGO_PATH=servicos_lc116_v2.json
NFSE_CMUN_IBGE=1302603
NFSE_CODIGO_TRIBUTACAO_PADRAO=

## PlugNotas (producao)
PLUGNOTAS_ENV=production
PLUGNOTAS_BASE_URL=https://api.plugnotas.com.br
PLUGNOTAS_API_KEY=
PLUGNOTAS_CNPJ_PATH=/cnpj/{cnpj}
PLUGNOTAS_NFSE_XML_PATH=/nfse/xml/{id}
PLUGNOTAS_NFSE_PDF_PATH=/nfse/pdf/{id}
PLUGNOTAS_NFSE_CANCEL_PATH=/nfse/cancelar/{idNota}
PLUGNOTAS_NFSE_CANCEL_STATUS_PATH=/nfse/cancelar/status/{cancellationProtocol}
PLUGNOTAS_HTTP_TIMEOUT_MS=30000
PLUGNOTAS_HTTP_MAX_ATTEMPTS=3
PLUGNOTAS_HTTP_BASE_DELAY_MS=500
PLUGNOTAS_HTTP_MAX_DELAY_MS=5000
PLUGNOTAS_PREREQ_MODE=off
PLUGNOTAS_PREREQ_CHECK_CITY=true
PLUGNOTAS_PREREQ_ENABLE_COMPANY=false
PLUGNOTAS_PREREQ_CITY_PATH=/Auxiliares/getCidadeById?id={ibge}
PLUGNOTAS_PREREQ_COMPANY_PATH=/empresa/{cnpj}
PLUGNOTAS_PREREQ_CACHE_TTL_MS=3600000
PLUGNOTAS_DEBUG_CONFIG=false
PLUGNOTAS_DEBUG_PAYLOAD=false

## SEFIN / LOBONOTAS (Ambiente Nacional NFS-e) — Slice 4/5 (default: desativado)
# Contrato canonico do provider do Ambiente Nacional: providerName = LOBONOTAS.
# FISCAL_PROVIDER_ACTIVE define o provider ativo na fabrica (FiscalProviderResolver).
# Valores: PLUGNOTAS (legado/rollback) | LOBONOTAS. Ausente -> PLUGNOTAS.
# SEFIN_ENABLED=true continua valido como forma legada de ativar LOBONOTAS.
FISCAL_PROVIDER_ACTIVE=
SEFIN_ENABLED=false
# https://sefin.producaorestrita.nfse.gov.br/API/SefinNacional (Producao Restrita) | https://sefin.nfse.gov.br/SefinNacional (Producao)
SEFIN_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/API/SefinNacional
SEFIN_ADN_BASE_URL=https://adn.producaorestrita.nfse.gov.br
# sefin_env: producao | homologacao | producaorestrita (inferido da URL quando ausente)
SEFIN_ENV=
# 1 = Producao; 2 = Homologacao/Producao Restrita (inferido do ambiente quando ausente)
SEFIN_TP_AMB=
SEFIN_HTTP_TIMEOUT_MS=30000
SEFIN_HTTP_MAX_ATTEMPTS=3
SEFIN_HTTP_BASE_DELAY_MS=500
SEFIN_HTTP_MAX_DELAY_MS=5000
SEFIN_VER_APLIC=ZERA-1.0
# Serie fixa inicial da DPS (1-5 digitos); contador atomico avanca dpsContador/dpsSerieContador na Empresa
SEFIN_DPS_SERIE=1
SEFIN_CMUN_IBGE=1302603
SEFIN_CODIGO_TRIBUTACAO_NACIONAL=
# Envelope do POST /nfse: producao exige JSON ({ "dps": "<xml assinado>" }); XML puro permanece disponivel apenas para compatibilidade
SEFIN_NFSE_ENVELOPE=json
SEFIN_VERIFY_CERT=true

## Piloto Manaus LOBONOTAS (Slice 5 — roteamento por CNPJ, default: desligado)
# LOBONOTAS_PILOT_ENABLED=true ativa roteamento por CNPJ: prestadores da allowlist
# emitem via LOBONOTAS; fora da allowlist permanecem em PLUGNOTAS (apenas na fase piloto).
# Sem a flag, nao existe roteamento automatico por CNPJ (comportamento global atual).
LOBONOTAS_PILOT_ENABLED=false
# Allowlist de CNPJs do piloto (separados por virgula, aceita mascara).
LOBONOTAS_CNPJS_MANAUS=

# Use sandbox apenas em homologacao.
# PLUGNOTAS_ENV=sandbox
# PLUGNOTAS_BASE_URL=https://api.sandbox.plugnotas.com.br
# PLUGNOTAS_API_KEY=

## Emissao rapida
QUICK_NFSE_CODIGO_NACIONAL=171901
QUICK_NFSE_CODIGO_TRIBUTACAO=100
QUICK_NFSE_DESCRICAO_PADRAO=Prestacao de servicos
QUICK_NFSE_ISS_ALIQUOTA=
QUICK_NFSE_OP_SIMP_NAC=3
QUICK_NFSE_REG_AP_TRIB_SN=1
QUICK_NFSE_REG_ESP_TRIB=0
QUICK_NFSE_TOMADOR_RAZAO_SOCIAL=CONSUMIDOR FINAL
QUICK_NFSE_TOMADOR_LOGRADOURO=NAO INFORMADO
QUICK_NFSE_TOMADOR_NUMERO=S/N
QUICK_NFSE_TOMADOR_COMPLEMENTO=
QUICK_NFSE_TOMADOR_BAIRRO=CENTRO
QUICK_NFSE_TOMADOR_MUNICIPIO=Manaus
QUICK_NFSE_TOMADOR_UF=AM
QUICK_NFSE_TOMADOR_CEP=69000000

## Integracoes externas
EXTERNAL_LOOKUP_TIMEOUT_MS=8000

CNPJA_BASE_URL=https://api.cnpja.com
CNPJA_API_KEY=
CNPJA_TIMEOUT_MS=12000
CNPJA_INCLUDE_SIMPLES=true
CNPJA_INCLUDE_SUFRAMA=true
CNPJA_REGISTRATIONS_MODE=ORIGIN
CNPJA_CACHE_STRATEGY=CACHE_IF_ERROR
CNPJA_CACHE_MAX_AGE_DAYS=45
CNPJA_CACHE_MAX_STALE_DAYS=365
# Valores aceitos: auto, raw, bearer.
CNPJA_AUTH_SCHEME=auto
CNPJA_STRICT_PRIMARY=true

BRASILAPI_BASE_URL=https://brasilapi.com.br/api/cnpj/v1
BRASILAPI_TIMEOUT_MS=12000

RECEITAWS_BASE_URL=https://receitaws.com.br/v1/cnpj
RECEITAWS_TIMEOUT_MS=12000

# HUBDEV_CADASTROPF_TOKEN tem prioridade; HUBDEV_TOKEN funciona como fallback.
HUBDEV_CADASTROPF_TOKEN=
HUBDEV_TOKEN=
HUBDEV_CADASTROPF_BASE_URL=https://ws.hubdodesenvolvedor.com.br/v2/cadastropf/
HUBDEV_CADASTROPF_TIMEOUT_MS=12000

## Scripts / OpenAPI (opcional)
# OPENAPI_BASE_URL=http://127.0.0.1:3000
# OPENAPI_JSON_PATH=openapi/openapi.json
# OPENAPI_TYPES_PATH=openapi/zera-api.d.ts
